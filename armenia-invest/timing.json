     "end": 19.9
    }
   ]
  },
  {
   "id": "s4",
   "start": 20.3,
   "end": 26.4,
   "caps": [
    {
     "text": "هم به [بازار داخلی] دسترسی داری،",
     "start": 20.35,
     "end": 22.47
    },
    {
     "text": "هم امکان [صادرات] محصولات دامی",
     "start": 22.47,
     "end": 24.593
    },
    {
     "text": "به [کشورهای اطراف] فراهمه.",
     "start": 24.593,
