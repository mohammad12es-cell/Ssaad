  },
  {
   "id": "s2",
   "start": 6.9,
   "end": 12.6,
   "caps": [
    {
     "text": "پرورش [گاو، گوسفند، مرغ]",
     "start": 6.95,
     "end": 9.407
    },
    {
     "text": "و سایر پرندگان توی [ارمنستان]،",
     "start": 9.407,
